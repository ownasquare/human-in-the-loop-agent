# Relay is credential-free and deterministic in demo mode.
RELAY_MODE=demo
RELAY_DATA_DIR=.relay
RELAY_HOST=127.0.0.1
RELAY_PORT=8000
# Host port used by Docker Compose. Change it if 8000 is already in use.
RELAY_HOST_PORT=8000

# Claude 3.5 Sonnet was retired by Anthropic on 2025-10-28. Relay defaults
# to its current Sonnet successor while keeping the model operator-configurable.
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# Set RELAY_MODE=live only after the connectors needed by the workflow are
# configured. Live mode fails closed; it never substitutes demo data.
TAVILY_API_KEY=
RESEND_API_KEY=
# Reserved placeholder. Replace only with a sender verified in the dedicated Resend test account.
RELAY_EMAIL_FROM=relay@example.invalid
# Controlled non-production recipient used only by `relay live resend`.
RELAY_ACCEPTANCE_EMAIL_TO=
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_CALENDAR_ID=primary
RELAY_CALENDAR_SEND_UPDATES_DEFAULT=none
